# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used for audited service operations (uploads, account deletion, e-mail queue).
SUPABASE_SECRET_KEY=

# Public address of the site (used in e-mail links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (optional; the CAPTCHA box is hidden when empty)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SMTP for notification e-mails (optional; notifications still appear in the app when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# "full": details in the e-mail · "summary": summary only, details in the app
EMAIL_DETAIL=summary

# Shared secret for the scheduled maintenance endpoint (/api/maintenance)
CRON_SECRET=

# Optional limits (bytes)
UPLOAD_MAX_FILE_BYTES=
EXPORT_MAX_TOTAL_BYTES=

# Integration tests against a separate Supabase test project (npm run test:supabase)
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
